programa {
    funcao inicio () {
real total
cadeia cliente
escreva ("Qual o valor total da compra? ")
leia(total)
escreva("Você é um estudante?")
leia (cliente)
se(cliente == "sim" e total >= 50.00) {
 escreva ("O cliente terá acesso ao benefício")
}senao {
    escreva("O cliente não terá acesso ao benefício") 
}
    }
}

   

