programa {
    funcao inicio () {
        real metros
        cadeia dia
        escreva("Qual a altura da maré em metros? ")
        leia (metros)
        escreva ("Está de dia ou está de noite? ")
        leia (dia)
        se(metros < 2 e dia == "dia" )
        {
            escreva("Pode ir até os recife e ir até o farol ")
        }
            senao {
                escreva("Você não pode ir até os recifes e farol")
            }
        }
    }
        
    
    
            