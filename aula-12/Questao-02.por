programa {
  funcao inicio() {
    // Declaração
  real base, altura, areaDoTriangulo
    // Entrada
escreva("Informe a base: ")
leia(base)
escreva("Informe a altura: ")
leia(altura)
    // Processamento
areaDoTriangulo = (base * altura) / 2
    // Saida
escreva("A area do trinagulo é de: ", areaDoTriangulo, "\n")
  }
}
