programa {
  funcao inicio() {
    // Declaração
    real nota1, nota2, media
    // Entrada
    escreva("Qual foi a primeira nota? ")
    leia(nota1)
    escreva("Qual foi a segunda nota? ")
    leia(nota2)
    // Processamento
    media = (nota1 + nota2) / 2
    // Saida
    escreva("A media do aluno é de: ", media, "\n")
  }
}
